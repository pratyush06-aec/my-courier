# AWS Configuration
AWS_REGION=eu-north-1

# Amazon Bedrock Configuration
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Google Cloud Pub/Sub (for watch renewal)
PUBSUB_TOPIC_NAME=projects/your-project/topics/gmail-push

# Gmail API Configuration
GMAIL_CREDENTIALS_JSON_PATH=credentials.json
GMAIL_TOKEN_JSON_PATH=token.json

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=whatsapp:+14155238886
TWILIO_TO_NUMBER=whatsapp:+1234567890

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Agent Configuration
ALLOWED_SENDERS=StudentBuilders@amazon.com,judkatha@amazon.com

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=EmailAgentProcessedMessages
